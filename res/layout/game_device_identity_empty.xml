<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/game_device_identity_intro_background"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <ImageView
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginBottom="12dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_videogame_vd_theme_24"
        android:tint="@color/settingslib_materialColorOnSurfaceVariant" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="@string/game_device_identity_no_games"
        android:textAppearance="@style/TextAppearance.SettingsLib.TitleMedium.Emphasized"
        android:textColor="@color/settingslib_materialColorOnSurface" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:text="@string/game_device_identity_no_games_summary"
        android:textAppearance="@style/TextAppearance.SettingsLib.BodyMedium"
        android:textColor="@color/settingslib_materialColorOnSurfaceVariant" />
</LinearLayout>
