<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/game_device_identity_intro_background"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/game_device_identity_icon_background"
            android:importantForAccessibility="no"
            android:padding="12dp"
            android:src="@drawable/ic_videogame_vd_theme_24"
            android:tint="@color/settingslib_materialColorOnPrimaryContainer" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:text="@string/game_device_identity_intro_title"
            android:textAppearance="@style/TextAppearance.SettingsLib.TitleLarge.Emphasized"
            android:textColor="@color/settingslib_materialColorOnSurface" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/game_device_identity_intro_summary"
            android:textAppearance="@style/TextAppearance.SettingsLib.BodyMedium"
            android:textColor="@color/settingslib_materialColorOnSurfaceVariant" />
    </LinearLayout>
</FrameLayout>
